generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserRole {
  CUSTOMER
  AGENCY
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum ReservationSource {
  CUSTOMER
  AGENCY
}

enum PriceRuleType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  MARKUP
}

enum PriceRuleTarget {
  ALL_AGENCIES
  SPECIFIC_AGENCY
  ALL_CUSTOMERS
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  EARLY_BOOKING
  LAST_MINUTE
  LONG_STAY
  DATE_RANGE
}

enum DiscountAudience {
  CUSTOMER
  AGENCY
  ALL
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponAudience {
  CUSTOMER
  NEW_CUSTOMER
  AGENCY
}

enum LocationType {
  COUNTRY
  CITY
  DISTRICT
  AREA
}

// ============ USER & AUTH ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  /// YYYY-AA-GG. Ödeme adımında ilk misafirin doğum tarihini doldurur.
  birthDate    String?
  /// ISO ülke kodu (TR, DE...). Hesaptaki uyruk; aramaya henüz bağlı değil.
  nationality  String?
  /// Giriş şifresiz (e-posta kodu); eski hesaplarda dolu kalabilir.
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency               Agency?             @relation("UserAgency")
  approvedAgencies     Agency[]            @relation("ApprovedByAdmin")
  reservations         Reservation[]
  searchHistories      SearchHistory[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  priceRules           PriceRule[]         @relation("CreatedByAdmin")
  reviewedApplications AgencyApplication[] @relation("ReviewedApplications")
  applications         AgencyApplication[] @relation("ApplicantApplications")
  savedGuests          SavedGuest[]
  couponUses           CouponUse[]
  createdDiscounts     Discount[]          @relation("DiscountCreatedBy")
  createdCoupons       Coupon[]            @relation("CouponCreatedBy")

  @@map("users")
}

// Hesaptaki "Kayıtlı misafirler": sık birlikte seyahat edilen kişiler.
// Ödeme adımında misafir formuna tek dokunuşla eklenir.
model SavedGuest {
  id        String   @id @default(cuid())
  userId    String
  name      String
  surname   String
  /// YYYY-AA-GG
  birthDate String
  gender    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_guests")
}

// Müşteri girişi için tek kullanımlık email kodu (passwordless login).
// Kod hash'lenerek saklanır; süresi dolunca veya kullanılınca silinir.
model LoginCode {
  id        String   @id @default(cuid())
  /// E-posta başına tek aktif kod.
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("login_codes")
}

// Acente başvurusu: hesap DEĞİLDİR. Acenteler bu formu doldurur, admin
// panelde inceleyip onaylarsa User + Agency hesabı oluşturulur.
model AgencyApplication {
  id              String            @id @default(cuid())
  contactName     String
  email           String
  phone           String?
  companyName     String
  taxId           String
  taxOffice       String?
  /// TÜRSAB belge no (A grubu seyahat acentesi).
  tursabNo        String?
  website         String?
  companyPhone    String?
  address         String?
  message         String?
  status          ApplicationStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  agencyId        String?           @unique
  /// Başvuruyu panelden yapan acente kullanıcısı (girişte açılan hesap).
  userId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reviewedBy User?   @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  user       User?   @relation("ApplicantApplications", fields: [userId], references: [id], onDelete: Restrict)
  agency     Agency? @relation(fields: [agencyId], references: [id])

  @@index([status])
  @@index([email])
  @@index([userId])
  @@index([taxId, status])
  @@map("agency_applications")
}

model Agency {
  id           String   @id @default(cuid())
  userId       String   @unique
  companyName  String
  taxId        String   @unique
  taxOffice    String?
  tursabNo     String?
  website      String?
  address      String?
  phone        String?
  /// Yüzde (0–100).
  discountRate Decimal  @default(0) @db.Decimal(5, 2)
  feedId       String?
  isApproved   Boolean  @default(false)
  approvedById String?
  /// Anlaşmadaki komisyon yüzdesi (0–100).
  commission   Decimal  @default(0) @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Restrict: acentenin geçmiş rezervasyon ve komisyonları kullanıcıyla silinmesin
  // (hesaplar yalnız pasife alınır).
  user         User               @relation("UserAgency", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy   User?              @relation("ApprovedByAdmin", fields: [approvedById], references: [id])
  reservations Reservation[]
  priceRules   PriceRule[]
  commissions  Commission[]
  application  AgencyApplication?

  @@map("agencies")
}

// ============ ROYAL API CACHE ============

model RoyalApiToken {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("royal_api_tokens")
}

model Currency {
  id   String @id @default(cuid())
  code String @unique
  name String

  @@map("currencies")
}

model BoardType {
  id   String @id @default(cuid())
  code String @unique
  name String

  @@map("board_types")
}

model HotelFacility {
  id         String @id @default(cuid())
  externalId String @unique
  category   String
  name       String

  @@map("hotel_facilities")
}

model RoomAttribute {
  id         String @id @default(cuid())
  externalId String @unique
  category   String
  name       String

  @@map("room_attributes")
}

model Location {
  id         String       @id @default(cuid())
  externalId String       @unique
  name       String
  parentId   String?
  type       LocationType @default(CITY)

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[] @relation("LocationHierarchy")
  hotels   Hotel[]

  @@index([parentId])
  @@map("locations")
}

model Hotel {
  id             String    @id @default(cuid())
  hotelCode      String    @unique
  name           String
  stars          Int?
  address        String?
  latitude       Float?
  longitude      Float?
  description    String?
  images         Json?
  facilities     Json?
  thumbnailImage String?
  locationId     String?
  /// Etscore otel detayı "otel aktif değil" dediyse false. Aramada ve
  /// içerik senkronunda atlanır. Otel listesi pasif otelleri de veriyor.
  isActive       Boolean   @default(true)
  /// Etscore aramasında en son fiyatla göründüğü an. Geniş bir şehirde
  /// (İstanbul binlerce otel) aramaya giden 600 kod bununla seçiliyor:
  /// fiyat verenler önce. Arama rotası ve gece taraması günceller.
  lastPricedAt   DateTime?
  phone          String?
  email          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  location Location? @relation(fields: [locationId], references: [id])

  // Şehir araması: konumdaki etkin oteller, fiyat verenler önce.
  @@index([locationId, isActive, lastPricedAt])
  @@map("hotels")
}

// ============ PRICING & RULES ============

model PriceRule {
  id          String          @id @default(cuid())
  name        String
  type        PriceRuleType
  /// Yüzde ya da (FIXED_DISCOUNT'ta) EUR tutar.
  value       Decimal         @db.Decimal(12, 2)
  appliesTo   PriceRuleTarget
  agencyId    String?
  hotelCode   String?
  boardType   String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean         @default(true)
  priority    Int             @default(0)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  agency    Agency? @relation(fields: [agencyId], references: [id])
  createdBy User?   @relation("CreatedByAdmin", fields: [createdById], references: [id])

  @@index([isActive, priority])
  @@index([agencyId])
  @@map("price_rules")
}

model Commission {
  id        String         @id @default(cuid())
  agencyId  String
  type      CommissionType
  /// Yüzde ya da (FIXED'de) EUR tutar.
  value     Decimal        @db.Decimal(12, 2)
  hotelCode String?
  boardType String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, isActive])
  @@map("commissions")
}

// ============ RESERVATIONS ============

model Reservation {
  id                      String            @id @default(cuid())
  bookingNumber           String?           @unique
  clientReferenceId       String            @unique @default(cuid())
  hotelCode               String
  hotelName               String?
  userId                  String
  agencyId                String?
  checkIn                 DateTime          @db.Date
  checkOut                DateTime          @db.Date
  status                  ReservationStatus @default(PENDING)
  /// Tedarikçi net fiyatı (maliyet).
  totalPrice              Decimal           @db.Decimal(12, 2)
  /// Müşterinin/acentenin ödediği satış fiyatı.
  discountedPrice         Decimal?          @db.Decimal(12, 2)
  discountAmount          Decimal?          @db.Decimal(12, 2)
  currency                String            @default("EUR")
  boardType               String?
  roomType                String?
  contactName             String?
  contactEmail            String?
  contactPhone            String?
  guests                  Json?
  cancellationPolicy      Json?
  roomConfirmationCodes   Json?
  hotelConfirmationNumber String?
  cancellationFee         Decimal?          @db.Decimal(12, 2)
  cancellationFeeCurrency String?
  appliedPriceRules       Json?
  /// Acente rezervasyonunda o anki komisyon tutarı (satış fiyatından; özel
  /// komisyon ya da anlaşma oranı). Oran sonradan değişse de bu değişmez.
  commissionAmount        Decimal?          @db.Decimal(12, 2)
  /// Uygulanan otomatik indirim (kampanya) ve tutarı.
  discountId              String?
  campaignDiscount        Decimal?          @db.Decimal(12, 2)
  /// Kullanılan kupon ve tutarı.
  couponId                String?
  couponDiscount          Decimal?          @db.Decimal(12, 2)
  source                  ReservationSource @default(CUSTOMER)
  notes                   String?
  /// Etscore fiyat kodu. Tekil: aynı fiyat koduyla iki rezervasyon açılamaz
  /// (çift tıklama, iki sekme). Başarısız denemede boşaltılır.
  priceCode               String?           @unique
  /// Tedarikçi yanıtı alınamadı ya da kayıt güncellenemedi: yönetim
  /// clientReferenceId ile Etscore'dan kontrol etmeli.
  needsReview             Boolean           @default(false)
  /// Durumun nedeni (hata, iptal notu) — yönetim için.
  statusNote              String?
  cancelledAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Finansal kayıt: bağlı kullanıcı, acente, kampanya ve kupon silinemez.
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  agency    Agency?    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  discount  Discount?  @relation(fields: [discountId], references: [id], onDelete: Restrict)
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponUse CouponUse?

  @@index([userId, createdAt])
  @@index([agencyId, status, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([hotelCode])
  @@index([discountId])
  @@index([couponId])
  @@index([checkIn, checkOut])
  @@map("reservations")
}

// ============ KAMPANYALAR ============

// Otomatik indirim (Airbnb gibi, kodsuz): koşulu tutan rezervasyona
// kendiliğinden uygulanır. Bir rezervasyona birden çok uyarsa en yüksek
// yüzde uygulanır (birleşmez). Kâr payı kuralından sonra satış fiyatından
// düşer (bkz. lib/pricing/engine).
model Discount {
  id           String           @id @default(cuid())
  name         String
  type         DiscountType
  percent      Float
  /// EARLY_BOOKING: girişe en az bu kadar gün.
  minDays      Int?
  /// LAST_MINUTE: girişe en fazla bu kadar gün.
  maxDays      Int?
  /// LONG_STAY: en az bu kadar gece.
  minNights    Int?
  /// DATE_RANGE: giriş tarihi bu aralıkta.
  stayStart    DateTime?        @db.Date
  stayEnd      DateTime?        @db.Date
  /// Kapsam: otel kodları doluysa yalnız onlar; yoksa konum adı (aramadaki
  /// gibi aynı adlı tüm konumlar ve altları); ikisi de boşsa tüm oteller.
  hotelCodes   String[]         @default([])
  locationName String?
  audience     DiscountAudience @default(CUSTOMER)
  /// Yayın aralığı; boşsa hemen / süresiz.
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean          @default(true)
  /// /kampanyalar vitrininde göster.
  showcase     Boolean          @default(false)
  description  String?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy    User?         @relation("DiscountCreatedBy", fields: [createdById], references: [id])
  reservations Reservation[]

  @@index([isActive])
  @@map("discounts")
}

// Kupon: müşteri ödeme adımında kodu yazar. Herkese açık listede görünmez.
model Coupon {
  id          String         @id @default(cuid())
  code        String         @unique
  type        CouponType
  /// Yüzde ya da (FIXED'de) EUR tutar.
  value       Decimal        @db.Decimal(12, 2)
  minAmount   Decimal?       @db.Decimal(12, 2)
  /// Toplam kullanım sınırı; boşsa sınırsız.
  usageLimit  Int?
  usedCount   Int            @default(0)
  perUserOnce Boolean        @default(true)
  audience    CouponAudience @default(CUSTOMER)
  expiresAt   DateTime?
  /// Otomatik indirimle birleşir mi; birleşmiyorsa müşteriye hangisi
  /// avantajlıysa o uygulanır.
  stacks      Boolean        @default(false)
  isActive    Boolean        @default(true)
  note        String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy    User?         @relation("CouponCreatedBy", fields: [createdById], references: [id])
  uses         CouponUse[]
  reservations Reservation[]

  @@map("coupons")
}

model CouponUse {
  id            String   @id @default(cuid())
  couponId      String
  userId        String
  reservationId String?  @unique
  amount        Decimal  @db.Decimal(12, 2)
  /// Kişi başı bir kez kuponlarda "couponId:userId": aynı anda iki
  /// rezervasyon aynı kuponu kullanamaz. Diğer kuponlarda boş.
  perUserKey    String?  @unique
  createdAt     DateTime @default(now())

  coupon      Coupon       @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@map("coupon_uses")
}

// ============ SYSTEM ============

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String?
  params      Json
  resultCount Int?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("search_histories")
}

model SystemSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?

  @@map("system_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}
