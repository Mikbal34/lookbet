# Production ortam değişkenleri şablonu.
# Kopyala: cp .env.production.example .env.production ve değerleri doldur.

# ---- Veritabanı: aynı sunucuda Docker Postgres ----
# POSTGRES_PASSWORD ile DATABASE_URL içindeki şifre AYNI olmalı.
# Host olarak compose servis adı "db" kullanılır.
POSTGRES_USER="lookbet"
POSTGRES_PASSWORD="BURAYA_GUCLU_BIR_SIFRE"
POSTGRES_DB="lookbet"
DATABASE_URL="postgresql://lookbet:BURAYA_GUCLU_BIR_SIFRE@db:5432/lookbet?schema=public"
# Docker Postgres SSL sunmaz; RDS gibi yönetilen DB kullanılırsa "true" yap.
DATABASE_SSL="false"

# ---- Otel verisi (Royal / Etscore) ----
# Gerçek tedarikçi bilgileri gelene kadar sahte veri modu açık:
ROYAL_API_MOCK="true"
ROYAL_API_BASE_URL="https://test-api.etscore.com"
ROYAL_API_USERNAME=""
ROYAL_API_PASSWORD=""
ROYAL_API_FEED_ID_B2C=""
ROYAL_API_FEED_ID_B2B=""

# ---- NextAuth ----
# NEXTAUTH_SECRET üret: openssl rand -base64 32
NEXTAUTH_SECRET="URETILECEK_RASTGELE_DEGER"
# Domain yokken sunucu IP'si (SSL eklenince https://alanadi yap):
NEXTAUTH_URL="http://SUNUCU_IP"

# ---- Sosyal giriş (opsiyonel — boşsa butonlar çalışmaz) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ---- Email kod girişi için mailer (boşsa kodlar sunucu loguna yazılır) ----
RESEND_API_KEY=""
EMAIL_FROM="Lookbet <noreply@lookbet.com>"

# ---- İlk kurulum seed (deploy sonrası bir kez çağrılır) ----
# GET /api/seed?token=SEED_TOKEN  → test kullanıcıları + mock içerik oluşturur.
SEED_TOKEN="URETILECEK_RASTGELE_DEGER"
SEED_ADMIN_PASSWORD="Lookbet123!"
